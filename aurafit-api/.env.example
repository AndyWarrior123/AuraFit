# =============================================================================
#  AuraFit API — Environment Configuration Template
#  Copy this file to .env and fill in all required values.
#  .env is gitignored. NEVER commit .env or any real secret to version control.
#
#  Generate a secure JWT secret key with:
#    python -c "import secrets; print(secrets.token_hex(64))"
#  or:
#    openssl rand -hex 64
# =============================================================================


# =============================================================================
#  APPLICATION
# =============================================================================

# Human-readable name used in OpenAPI docs and log output
APP_NAME="AuraFit API"

# Runtime environment. Controls log verbosity, error detail exposure, and
# debug tooling. Values: development | staging | production
ENVIRONMENT=development

# Enables FastAPI debug mode and SQLAlchemy query echo.
# MUST be false in production.
DEBUG=true

# Structured log level. Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# API version prefix — all routes mount under this path
API_V1_PREFIX=/api/v1


# =============================================================================
#  SERVER
# =============================================================================

# Uvicorn bind address. Use 0.0.0.0 inside Docker, 127.0.0.1 for local-only.
HOST=0.0.0.0
PORT=8000

# Number of Uvicorn worker processes.
# Formula for production: (2 × CPU cores) + 1
# Keep at 1 for development (hot-reload requires single worker).
WORKERS=1


# =============================================================================
#  DATABASE  —  PostgreSQL via asyncpg
# =============================================================================

# Full asyncpg DSN. Format:
#   postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
#
# Docker Compose default (matches docker-compose.yml service name):
DATABASE_URL=postgresql+asyncpg://aurafit:secret@localhost:5432/aurafit

# SQLAlchemy async connection pool settings.
# pool_size: persistent connections kept open.
# max_overflow: additional connections allowed above pool_size under load.
# Keep pool_size × WORKERS below your PostgreSQL max_connections (default 100).
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Seconds a connection can remain idle before being recycled.
# Must be less than PostgreSQL's idle_in_transaction_session_timeout.
DATABASE_POOL_RECYCLE=3600


# =============================================================================
#  SECURITY — JWT
# =============================================================================

# !! REQUIRED — CHANGE THIS !!
# Minimum 64 hex characters (256 bits of entropy). Used to sign all JWTs.
JWT_SECRET_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_64

# HMAC algorithm for JWT signing.
# HS256 is sufficient for a single-backend deployment.
# Upgrade to RS256 if you add a separate auth microservice in future.
JWT_ALGORITHM=HS256

# Short-lived access token TTL in minutes.
# 60 minutes is the industry standard for web clients.
# Android clients may request a longer value; keep ≤ 120 minutes.
JWT_ACCESS_EXPIRE_MINUTES=60

# Long-lived refresh token TTL in days.
# Used to silently issue new access tokens without re-prompting Google Sign-In.
JWT_REFRESH_EXPIRE_DAYS=30


# =============================================================================
#  GOOGLE OAUTH 2.0
#  Console: https://console.cloud.google.com/apis/credentials
#  Create an "OAuth 2.0 Client ID" of type "Web application".
#
#  Required OAuth scopes to enable in Cloud Console:
#    openid
#    email
#    profile
#    https://www.googleapis.com/auth/fitness.activity.read
#    https://www.googleapis.com/auth/fitness.heart_rate.read
#    https://www.googleapis.com/auth/fitness.sleep.read
#    https://www.googleapis.com/auth/fitness.body.read
# =============================================================================

# !! REQUIRED !!
# Format: <numbers>-<hash>.apps.googleusercontent.com
# Used by the backend to verify Google ID token audience (aud) claim.
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# !! REQUIRED !!
# Never expose this in frontend code. Backend-only.
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# OAuth callback URL registered in Cloud Console → Authorized redirect URIs.
# Development: http://localhost:8000/api/v1/health/sync/callback
# Production:  https://api.aurafit.io/api/v1/health/sync/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/health/sync/callback

# Google's public endpoint for verifying ID tokens.
# Only change this if Google publishes a v4 endpoint.
GOOGLE_TOKEN_INFO_URL=https://oauth2.googleapis.com/tokeninfo


# =============================================================================
#  GEMINI AI
#  Get your API key: https://aistudio.google.com/app/apikey
#  Note: The key used here is a server-side key with no browser restrictions.
# =============================================================================

# !! REQUIRED !!
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Model identifier. gemini-2.0-flash balances speed and accuracy for
# structured output extraction. Upgrade to gemini-2.0-pro for complex
# multi-activity transcripts if accuracy becomes insufficient.
GEMINI_MODEL=gemini-2.0-flash

# Max tokens in a single Gemini response. Our JSON schema response is
# always under 400 tokens — this cap prevents runaway billing.
GEMINI_MAX_OUTPUT_TOKENS=512

# Temperature 0.0 forces fully deterministic output.
# CRITICAL: never raise this above 0.1 for JSON extraction tasks —
# higher values introduce hallucinated field values.
GEMINI_TEMPERATURE=0.0


# =============================================================================
#  CORS — Cross-Origin Resource Sharing
#  JSON array of allowed origins. Add your production domain before deploying.
#  The React Vite dev server runs on 5173 by default.
# =============================================================================

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Expose Authorization header to browser clients (required for JWT in React).
CORS_ALLOW_CREDENTIALS=true


# =============================================================================
#  RATE LIMITING  (enforced in app/core/middleware.py — Phase 2)
# =============================================================================

# Max requests per client IP per window.
RATE_LIMIT_REQUESTS=100

# Sliding window duration in seconds.
RATE_LIMIT_WINDOW_SECONDS=60


# =============================================================================
#  ANDROID CLIENT BRIDGE  (Phase 2 — values reserved, not yet consumed)
#  When the Android client is added, Health Connect writes to Google's cloud.
#  The backend sync endpoint pulls from the same Google Fitness API — no new
#  env vars are needed. Only the scopes above expand if Wear OS is added:
#
#  Additional Wear OS scope (Phase 2):
#    https://www.googleapis.com/auth/fitness.location.read
# =============================================================================